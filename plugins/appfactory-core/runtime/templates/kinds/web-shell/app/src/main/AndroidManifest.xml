<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- INTERNET is required from API 1 up: the command server binds 127.0.0.1, and
         loopback is still the network stack; see preflight check 120. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- ShellForegroundService's declared type. Android 14+ (API 34) rejects a
         foreground service start whose type does not match one of these. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- API 33+. MainActivity requests this once and degrades gracefully on denial:
         the shell keeps working with no visible notification, it never blocks the
         foreground service start on it. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- android:name MUST point at the @HiltAndroidApp class; see App.kt. -->
    <application
        android:name=".{{APP_CLASS}}"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.{{APP_CLASS}}"
        android:networkSecurityConfig="@xml/network_security_config"
        tools:targetApi="36">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:label="@string/app_name"
            android:theme="@style/Theme.{{APP_CLASS}}">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Deep link: MainActivity is singleTask, so a link arriving while the
                 app is already open reaches onNewIntent rather than a new instance,
                 and onNewIntent forwards it to the page as window.__sagNative.onIntent(). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="{{DEEPLINK_SCHEME}}" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.ShellForegroundService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

    </application>

</manifest>
